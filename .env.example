# Copia este archivo como ".env" y completa los valores. El archivo .env NO se sube a Git.

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pega-aqui-una-clave-larga-y-aleatoria

# Base de datos MySQL en AWS RDS (si DB_HOST no existe, se usa SQLite local)
DB_HOST=elixir-urbano.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=elixir_urbano
DB_USER=admin
DB_PASSWORD=tu_clave_de_rds
